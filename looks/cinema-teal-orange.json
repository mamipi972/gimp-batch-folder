{
  "name": "Cinéma teal & orange",
  "description": "Étalonnage type cinéma : ombres bleu-vert, hautes lumières ambrées, contraste et saturation renforcés.",
  "steps": [
    { "op": "gegl:brightness-contrast","params": { "contrast": 1.18, "brightness": -0.015 } },
    { "special": "split-tone",         "params": { "shadows": "#0f4c5c", "highlights": "#ff9f45", "amount": 34.0 } },
    { "op": "gegl:saturation",         "params": { "scale": 1.12 } },
    { "op": "gegl:vignette",           "params": { "color": "#000000", "radius": 1.3, "softness": 0.7, "gamma": 2.2, "proportion": 1.0 }, "opacity": 60.0 }
  ]
}
